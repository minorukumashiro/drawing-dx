rules_version = '2';
// 図面DXプラットフォーム Firestoreセキュリティルール
// ログイン済み かつ 許可リストのメールアドレスのみ読み書き可能。
// スタッフを追加する場合:
//   1. Firebaseコンソール > Authentication > Users でアカウントを作成
//   2. 下のリストにメールアドレスを1行追加（カンマ区切り）
//   3. Firestore Database > ルール にこのファイルの内容を貼り付けて「公開」
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null
        && request.auth.token.email in [
          'tokyohoning@gmail.com'
        ];
    }
  }
}
